# En-têtes Netlify. Ce fichier n'est pas publié : Netlify le consomme.
#
# CORS EST NÉCESSAIRE, PAS DÉCORATIF. Un vérificateur qui exécute son outil dans
# un navigateur lit ce document depuis une AUTRE origine que natixar.pro. Sans
# `Access-Control-Allow-Origin`, la requête échoue — et elle échoue du côté du
# vérificateur, sur une page que nous ne voyons pas. Le document est une clé
# publique : `*` est la valeur juste, pas une concession.
/.well-known/did.json
  Access-Control-Allow-Origin: *
  Content-Type: application/json
  # Court, parce qu'une clé ajoutée doit être visible sans attendre un cache.
  # `did:web` n'a pas de mécanisme de révocation : la fraîcheur du document est
  # le seul levier.
  Cache-Control: public, max-age=300

# Descripteur d'environnement — kubb
# Aucun secret ici. Ce fichier est versionné et lisible par tous.
# Il décrit la topologie ; les identifiants viennent de secrets/fetch.sh.

DEPLOY_HOST=kubb
DEPLOY_USER=claude-ia

# IPv6 a disparu du poste de contrôle le 30/07/2026 et la résolution part
# volontiers sur l'AAAA. Sans -4, ssh échoue en "No route to host".
DEPLOY_SSH_OPTS="-4 -o BatchMode=yes -o ConnectTimeout=8"

# Réseau Docker sur lequel le fournisseur docker de Traefik est épinglé.
# Un conteneur absent de ce réseau est vu par Traefik mais reste injoignable.
PROXY_NETWORK=proxy

# Domaines servis par le squelette. Le premier est le domaine de référence.
# Domaines réellement servis. natixar.critical-optimisation.com est retiré :
# aucun enregistrement DNS ne l'a jamais résolu, et une vérification sur un nom
# inexistant échoue pour une raison qui n'a rien à voir avec le déploiement.
APP_DOMAINS="guyana.natixar.pro"

# Nom du conteneur applicatif, interrogé par verify-network.
APP_CONTAINER=guyana-site

# Voisins dont la non-régression est vérifiée après chaque déploiement,
# sous la forme hôte=code_attendu
NEIGHBOURS="whoami.critical-optimisation.com=200 traefik.critical-optimisation.com=401 natixar.pro=200"

# Préfixe réservé de nos routeurs dans l'espace de noms partagé de Traefik.
ROUTER_PREFIX=guyana

# Sous-domaines RÉSERVÉS sur kubb : ne jamais les revendiquer.
#   whoami.*  fonction de test
#   portal.*  réservé
#   traefik.* tableau de bord, filtré LAN uniquement
# Tout le reste est disponible.
RESERVED_SUBDOMAINS="whoami portal traefik"

# Services opérationnels de kubb, à ne pas perturber.
#   OpenERP : seul service opérationnel, en LXC via Juju (pas Docker).
#   Son fichier de routage juju-gourou-openerp-server.yml est GÉNÉRÉ
#   automatiquement depuis les données Juju — ne jamais l'éditer à la main.
OPERATIONAL_SERVICES="openerp"

# --- services/ (issue #66) — topologie, jamais de secret ------------------
# Deux processus qui ne se font pas confiance : le signataire détient la clé et
# pas la base, le magasin détient la base et aucune clé. DB_NETWORK est le
# réseau que le signataire ne doit PAS joindre.
SIGNER_CONTAINER=guyana-signer
SIGNER_PORT=8081
STORE_CONTAINER=guyana-store
STORE_PORT=8082
DB_CONTAINER=guyana-db
DB_NETWORK=guyana-data
# Épinglée par digest : une étiquette mobile ferait varier ce qui tourne sans
# que rien ne change dans le dépôt.
DB_IMAGE=postgres:17-alpine@sha256:742f40ea20b9ff2ff31db5458d127452988a2164df9e17441e191f3b72252193
DB_VOLUME=guyana-db-data
DB_NAME=aurora
DB_USER=aurora

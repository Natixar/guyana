# Descripteur d'environnement — kubb
# Aucun secret ici. Ce fichier est versionné et lisible par tous.
# Il décrit la topologie ; les identifiants viennent de secrets/fetch.sh.

DEPLOY_HOST=kubb
DEPLOY_USER=claude-ia

# IPv6 a disparu du poste de contrôle le 30/07/2026 et la résolution part
# volontiers sur l'AAAA. Sans -4, ssh échoue en "No route to host".
DEPLOY_SSH_OPTS="-4 -o BatchMode=yes -o ConnectTimeout=8"

# Réseau Docker sur lequel le fournisseur docker de Traefik est épinglé.
# Un conteneur absent de ce réseau est vu par Traefik mais reste injoignable.
PROXY_NETWORK=proxy

# Domaines servis par le squelette. Le premier est le domaine de référence.
APP_DOMAINS="guyana.natixar.pro natixar.critical-optimisation.com"

# Voisins dont la non-régression est vérifiée après chaque déploiement,
# sous la forme hôte=code_attendu
NEIGHBOURS="whoami.critical-optimisation.com=200 traefik.critical-optimisation.com=401 natixar.pro=200"

# Préfixe réservé de nos routeurs dans l'espace de noms partagé de Traefik.
ROUTER_PREFIX=guyana
